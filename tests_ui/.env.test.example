# Public read-only smoke tests may use the live application URL.
# Authenticated tests require a separate staging deployment and synthetic user.
APP_ENV=staging
APP_BASE_URL=https://auvrynplatform.vercel.app
API_BASE_URL=https://coreflow-one-seven.vercel.app/api
BROWSER=chrome
HEADLESS=true
WAIT_TIMEOUT=12
PAGE_LOAD_TIMEOUT=45
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
CLIENT_TEST_ACCOUNT_EMAIL=
CLIENT_TEST_ACCOUNT_PASSWORD=
ALLOW_TEST_DATA_CHANGES=false
ALLOW_PRODUCTION_READONLY=false
