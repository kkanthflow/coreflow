SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7
DATABASE_URL=postgres://user:password@host:port/database

# ==========================================
# RAZORPAY SUBSCRIPTION GATEWAY CONFIGURATION
# ==========================================
# Get credentials from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Get webhook secret from Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional: Specific recurring plan IDs (if created beforehand in Razorpay Dashboard)
# If omitted, Auvryn auto-provisions and caches them using the Subscriptions API
RAZORPAY_PLAN_FREELANCER_MONTHLY=plan_your_freelancer_monthly_id
RAZORPAY_PLAN_FREELANCER_YEARLY=plan_your_freelancer_yearly_id
RAZORPAY_PLAN_STARTER_MONTHLY=plan_your_starter_monthly_id
RAZORPAY_PLAN_STARTER_YEARLY=plan_your_starter_yearly_id
RAZORPAY_PLAN_PRO_MONTHLY=plan_your_pro_monthly_id
RAZORPAY_PLAN_PRO_YEARLY=plan_your_pro_yearly_id

# Subscription Grace Period Policy (days to retain access before suspension)
SUBSCRIPTION_GRACE_PERIOD_DAYS=3
