{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "UI tests: smoke",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "pytest",
        "-c",
        "tests_ui/pytest.ini",
        "-m",
        "smoke"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "UI tests: all",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "pytest",
        "-c",
        "tests_ui/pytest.ini"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
